<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Hostinger's Git deploy keeps a .git folder inside the site folder. Never
  # serve it, nor the deploy script's asset list (.deploy-assets).
  RewriteRule (^|/)\.(git|deploy-assets)(/|$) - [R=404,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Allow iframe embedding from main site
<IfModule mod_headers.c>
  Header set Content-Security-Policy "frame-ancestors 'self' https://nariandkage.com https://www.nariandkage.com"
</IfModule>

# Caching.
#
# Firebase Hosting serves only the admin site: the order site is served by
# Hostinger (Git deploy from the nariandkage/order-site repo), so this file
# is the only place these headers can come from. Without them a returning customer re-downloads the
# whole bundle on every visit.
#
# Vite fingerprints everything in /assets/ (index-9856QR81.js and so on), so
# those files are safe to cache forever: a new build produces a new name.
# index.html must never be cached, since it is what points at the new names;
# a stale copy pins the customer to a deleted bundle. The manifest and icons
# sit in between, revalidated so a changed icon shows up without a hard
# refresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # These must come after the .js rule above, which would otherwise pin them
  # as immutable for a year. Apache applies the last matching Header set.
  #
  # sw.js and registerSW.js are unfingerprinted, so a cached copy is how a
  # PWA gets stuck on an old service worker: the browser would keep serving
  # the year-old worker, and the worker is what decides which build every
  # installed customer sees. workbox-*.js is content-hashed, so it is left
  # to the immutable rule above.
  <FilesMatch "^(index\.html|manifest\.webmanifest|sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>
